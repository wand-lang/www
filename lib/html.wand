-- Small pieces of HTML: escaping text, making anchors from headings, and a
-- command with a button that copies it.

import Regex
import String

-- Text made safe to stand in an element or in a quoted attribute.
let escape text =
  text
  |> String.replace "&" "&amp;"
  |> String.replace "<" "&lt;"
  |> String.replace ">" "&gt;"
  |> String.replace `"` "&quot;"

-- The anchor GitHub gives a heading: lower case, punctuation removed, and a
-- dash for each space. The reference links to its own headings this way, so
-- the site has to make the same anchors to keep those links working.
let slug title =
  title |> String.lower |> Regex.replace_all r/[^a-z0-9 _-]/ "" |> String.replace " " "-"

let _copy_icon =
  `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"/></svg>`

-- One shell command, with a button that copies it: the home page's install
-- line, and a one-line `sh` block in the reference. `label` names the
-- button for a screen reader.
let command label text = `
<div class="cmd">
<pre><code><span class="p">$ </span><span data-copy-text>%{escape text}</span></code></pre>
<button type="button" class="copy-icon" aria-label="%{escape label}" data-copy>%{_copy_icon}</button>
</div>`
